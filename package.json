{
  "name": "cardano-explorer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "build:prod": "GENERATE_SOURCEMAP=false craco build",
    "analyze": "npm run build && npx webpack-bundle-analyzer build/static/js/*.js",
    "start:prod": "npx serve -s build -l 3000",
    "test": "craco test",
    "eject": "craco eject",
    "deploy": "cross-env NODE_ENV=production node server",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "preload": "npm run build:prod && npm run start:prod"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@mui/x-data-grid": "^8.12.1",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^13.0.0",
    "@testing-library/user-event": "^13.2.1",
    "@types/jest": "^27.0.1",
    "@types/node": "^16.7.13",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "axios": "^0.21.2",
    "camelcase-keys": "^6.2.2",
    "cross-env": "^7.0.2",
    "dotenv": "^8.2.0",
    "highcharts": "^12.3.0",
    "highcharts-react-official": "^3.2.2",
    "nprogress": "^0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^7.2.0",
    "react-router-dom": "^6.30.1",
    "react-scripts": "5.0.1",
    "recoil": "^0.7.7",
    "styled-components": "^5.1.1",
    "typescript": "^4.4.2",
    "web-vitals": "^2.1.0"
  },
  "devDependencies": {
    "@babel/types": "^7.25.2",
    "@craco/craco": "^7.1.0",
    "@hot-loader/react-dom": "17.0.2",
    "@types/react-router-dom": "^5.3.3",
    "@types/styled-components": "^5.1.34",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "babel-eslint": "^10.1.0",
    "babel-plugin-import": "^1.13.8",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
